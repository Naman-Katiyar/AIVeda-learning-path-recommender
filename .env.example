NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://localhost:27017/aiveda
JWT_SECRET=replace-with-a-long-random-secret

# AI Configuration
# Use 'gemini' for real SaaS behavior and set AI_API_KEY for production use.
# Use 'mock' only for local, non-production testing.
# Get your Gemini API key here: https://aistudio.google.com/app/apikey
AI_PROVIDER=gemini
AI_API_KEY=your_gemini_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
AI_MODEL=gemini-3.6-flash

CLIENT_URL=http://localhost:5173
